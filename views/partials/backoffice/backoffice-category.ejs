<div class="col-md-16 col-lg-10">
    <div class="table-responsive" style="padding-top: 20px;">
      <table>
        <thead>
          <tr>
            <th>Image</th>
            <th>Category Name</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach((category, index) => { %>
          <tr>
            <td data-cell="Image">
              <img class="tableImage" style="padding-right: 10px;" src="<%= category.image_path %>"alt=" <%= category.category_name %>"/>
            </td>
            <td data-cell="Category Name" style="padding-right: 10px;"><%= category.category_name %></td>
            <td data-cell="Action" style="padding-right: 10px;">
              <a href="/backoffice/category/edit/<%= category.category_id %>" class="btn btn-warning btn-sm">Edit</a>
              <button class="btn btn-danger btn-sm delete-category" data-id="<%= category.category_id %>">Delete</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
  $(document).ready(function () {
    $(".delete-category").on("click", function(e) {
      e.preventDefault();
      const categoryId = $(this).data("id");

      if (confirm("Are you sure you want to delete this category?")) {
        $.ajax({
          url: `/backoffice/category/${categoryId}`,
          method: "DELETE",
          success: function(response) {
            alert(response.message);
            window.location.href = "/backoffice/category";
          },
          error: function(xhr) {
            alert(xhr.responseJSON.error);
          }
        });
      }
    });
  });
</script>