<%- include("../../partials/header.ejs") %>

    <div id="login" class="d-flex flex-column justify-content-center align-items-center vh-100">

        <div id="login-bg"
            class="container-fluid login z-0 opacity-25 position-absolute top-0 start-0 background-image"></div>

        <h1 class="title z-1">DAZZLE</h1>

        <div class="row w-100 d-flex justify-content-center align-items-center">
            <div class="z-1 opacity-100 bg-light p-5 shadow border-1 border border-secondary col-12 col-md-8 col-lg-6">
                <form action="/auth/login" method="post">
                    <h1 class="text-center fs-3 header">
                        <%= pageTitle %>
                    </h1>

                    <div>
                        <label for="email" class="mb-2 fw-semibold">Email</label>
                        <input id="email" type="email" name="email" class="form-control mb-3"
                            placeholder="Enter your email" required>
                    </div>

                    <div class="mt-3">
                        <label for="password" class="mb-2 fw-semibold">Password</label>
                        <input id="password" type="password" name="password" class="form-control mb-3"
                            placeholder="Enter your password" required>
                    </div>

                    <% if(errorMessage) { %>
                        <div class="text-danger mt-3">
                            <i class="bi bi-x-circle"></i>
                            <span class="ms-1"><%= errorMessage %></span>
                        </div>
                    <% } %>

                    <button class="btn w-100 mt-3">Login</button>
                    <p class="mt-3 text-body-tertiary text-center">Don't have an account? <a href="/auth/register"
                            class="text-dark fw-semibold">Register</a></p>
                </form>
            </div>
        </div>
    </div>

    <%- include("../../partials/footer.ejs") %>