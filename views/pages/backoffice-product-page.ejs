<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DAZZLE admin - Products</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.min.css"
    />
    <link rel="stylesheet" href="/css/backoffice-styles.css" />
  </head>
  <body>
    <!-- Header -->
    <%- include('../partials/backoffice/backoffice-header') %>

    <!-- Mobile Navigation -->
    <%- include('../partials/backoffice/backoffice-mobile-nav', { activePage:
    'products' }) %>

    <!-- Action Bar -->
    <div class="action-bar">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
            <a href="/backoffice/product/add" class="btn btn-success mr-2"
              ><i class="bi bi-file-arrow-down-fill"></i>Add Product</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar (Desktop) -->
        <%- include('../partials/backoffice/backoffice-sidebar', { activePage:
        'products' }) %>

        <!-- Content Area -->
        <%- include('../partials/backoffice/backoffice-product', { products:
        products }) %>
      </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
      $(document).ready(function () {
        // Toggle mobile navigation menu
        $("#menuToggle").click(function () {
          $("#mobileNav").toggleClass("show");
        });

        // Handle navigation button clicks
        $(".nav-button").click(function () {
          $(".nav-button").removeClass("active");
          $(this).addClass("active");
        });
      });
    </script>
  </body>
</html>
