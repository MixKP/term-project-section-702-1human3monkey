<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DAZZLE admin - Edit Category</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/backoffice-styles.css">
  <link rel="stylesheet" href="/css/backoffice-addcategory-styles.css">
</head>
<body>
  <!-- Header -->
  <%- include('../partials/backoffice/backoffice-header') %>

  <!-- Main Content -->
  <div class="container mt-4">
    <div class="d-flex align-items-center mb-3">
      <i class="bi bi-file-arrow-down-fill text-primary" style="font-size: 24px;"></i>
      <h2 class="ml-2 mb-0">Edit Category</h2>
    </div>

    <form id="editCategoryForm">
      <div class="form-group">
        <label for="categoryName">Name</label>
        <input type="text" class="form-control" id="categoryName" name="categoryName" value="<%= category.category_name %>" placeholder="Enter category name">
      </div>
      <div class="form-group">
        <label for="categoryImage">Current Image</label>
        <div>
          <img src="<%= category.image_path %>" alt="<%= category.category_name %>" class="tableImage" />
        </div>
      </div>
      <div class="form-group">
        <label for="imageInput">Change Image</label>
        <input type="file" class="form-control-file" id="categoryImage" name="imageInput">
      </div>
      <button type="submit" class="btn btn-success">Submit</button>
    </form>
  </div>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script>
    document.querySelector('.menusidebar').remove();
    $(document).ready(function() {
      $("#editCategoryForm").on("submit", function(e) {
        e.preventDefault();
        handleFormSubmission();
      });
    });

    function handleFormSubmission() {
      const formData = new FormData(document.getElementById('editCategoryForm'));

      $.ajax({
        url: "/backoffice/category/<%= category.category_id %>",
        method: "PUT",
        data: formData,
        processData: false,
        contentType: false,
        success: function(response) {
          alert(response.message);
          window.location.href = "/backoffice/category";
        },
        error: function(xhr) {
          alert(xhr.responseJSON.error);
        }
      })
    }
  </script>
</body>
</html>