<%- include("../partials/header.ejs") %>
<%- include("../partials/navbarFrontPage.ejs") %>

<div class="product-container">
  <div id="product-detail" class="product-detail"></div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async function () {
    let productData;

    async function fetchProductData() {
      try {
        const productId = '<%= productId %>'; // Get the product ID from server
        console.log("Fetching product data for ID:", productId);
        
        const response = await fetch(`/product/${productId}/details`);
        productData = await response.json();

        if (productData.error) {
          document.getElementById('product-detail').innerHTML = "<p>Product not found.</p>";
          return;
        }

        populateProductDetails(productData);
      } catch (error) {
        console.error('Error fetching product data:', error);
        document.getElementById('product-detail').innerHTML = "<p>Error loading product.</p>" + error;
      }
    }

    function populateProductDetails(product) {
      const productDetail = document.getElementById('product-detail');
      productDetail.innerHTML = `
        <div class="product-image">
          <img src="${product.image_path}" alt="${product.product_name}">
        </div>
        <div class="product-info">
          <div class="product-header">
            <p class="product-category">${product.category_name || 'PRODUCT'}</p>
            <p class="product-id">ID: ${product.product_id}</p>
          </div>
          <h1 class="product-title">${product.product_name}</h1>
          <div class="product-price">
            ${product.discount_percent > 0 ? 
              `<span class="original-price">$${product.normal_price.toLocaleString()}</span>

               <span class="discount-price">$${(product.normal_price - (product.normal_price * product.discount_percent)).toLocaleString()}</span>
               <span class="discount-badge">-${product.discount_percent*100}%</span>` : 
              `$${product.normal_price.toLocaleString()}`
            }
          </div>
          <div class="product-features">
            <ul>
              ${product.description ? `<li>${product.description}</li>` : ''}
              ${(product.features || []).map(feature => `<li>${feature}</li>`).join('')}
            </ul>
          </div>

          <form id="add-to-cart-form" action="/cart/add" method="POST">
            <input type="hidden" name="product_id" value="${product.product_id}">
            <input type="hidden" id="product_attribute_id" name="product_attribute_id" value="">

            <div class="product-options">
              <div class="size-selector">
              <h3>Size</h3>
              <div class="size-options">
                ${getUniqueSizes(product.attributes).map(size => `
                  <button type="button" class="size-btn ${product.attributes.some(attr => attr.size === size && attr.quantity > 0) ? '' : 'disabled'}"
                    data-size="${size}"
                    ${product.attributes.some(attr => attr.size === size && attr.quantity > 0) ? '' : 'disabled'}>
                    ${size}
                  </button>
                `).join('')}
              </div>
            </div>
            <div class="color-selector">
              <h3>Color</h3>
              <div class="color-options">
                <!-- Colors will be dynamically updated -->
              </div>
            </div>
          </div>

          <div class="quantity-selector pt-3">
            <h3>Quantity</h3>
            <input type="number" id="quantity" class="form-control" name="quantity" value="1" min="1" max="99" pattern="[0-9]*" inputmode="numeric">
          </div>

          <div class="product-actions">
            <button type="submit" class="add-to-cart-btn">ADD TO CART</button>
          </div>
        </form>

          <div class="shipping-info">
            <p>*No refund on return</p>
          </div>
        </div>
      `;

      addEventListeners();
    }

    function getUniqueSizes(attributes) {
      return [...new Set(attributes.map(attr => attr.size))];
    }

    function addEventListeners() {
      document.querySelectorAll('.size-btn:not(.disabled)').forEach(btn => {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('selected'));
          this.classList.add('selected');

          updateAvailableColors(this.dataset.size);
        });
      });

      document.getElementById('add-to-cart-form').addEventListener('submit', function (event) {
        event.preventDefault();

        const selectedSize = document.querySelector('.size-btn.selected')?.dataset.size;
        const selectedColor = document.querySelector('.color-btn.selected')?.dataset.color;

        const selectedAttribute = productData.attributes.find(attr => 
          attr.size === selectedSize && attr.color === selectedColor
        );

        if (!selectedSize || !selectedColor || !selectedAttribute) {
          alert('Please select size and color');
          return;
        }

        document.getElementById('product_attribute_id').value = selectedAttribute.product_attribute_id;

        console.log('Adding to cart:', {
          productId: productData.product_id,
          productAttributeId: selectedAttribute.product_attribute_id,
          size: selectedSize,
          color: selectedColor,
          quantity: document.getElementById('quantity').value
        });

        const submitBtn = this.querySelector('.add-to-cart-btn');
        submitBtn.textContent = 'ADDED!';

        const quantity = document.getElementById('quantity').value;
        if (quantity < 1 || quantity > selectedAttribute.quantity) {
          alert('Invalid quantity');
          return;
        }

        document.getElementById('product_attribute_id').value = selectedAttribute.product_attribute_id;
        this.submit();
      });

      document.querySelector('.add-to-cart-btn').addEventListener('click', function () {
        const selectedSize = document.querySelector('.size-btn.selected')?.dataset.size;
        const selectedColor = document.querySelector('.color-btn.selected')?.dataset.color;

        if (!selectedSize || !selectedColor) {
          alert('Please select both size and color');
          return;
        }

        // Find the product attribute ID for the selected size and color
        const selectedAttribute = productData.attributes.find(attr => 
          attr.size === selectedSize && attr.color === selectedColor
        );

        if (!selectedAttribute || selectedAttribute.quantity <= 0) {
          alert('Selected product is out of stock');
          return;
        }

        console.log('Adding to cart:', {
          productId: productData.product_id,
          productAttributeId: selectedAttribute.product_attribute_id,
          size: selectedSize,
          color: selectedColor
        });

        // Here you would typically make an API call to add the item to the cart
        // For now, we'll just show a visual confirmation
        this.textContent = 'ADDED!';
        setTimeout(() => this.textContent = 'ADD TO CART', 2000);
      });
    }

    function updateAvailableColors(selectedSize) {
      const colorContainer = document.querySelector('.color-options');
      colorContainer.innerHTML = ''; // Clear previous colors

      // Get colors available for the selected size
      const availableColors = productData.attributes
        .filter(attr => attr.size === selectedSize && attr.quantity > 0)
        .map(attr => attr.color);

      // Remove duplicates
      [...new Set(availableColors)].forEach(color => {
        const colorBtn = document.createElement('button');
        colorBtn.classList.add('color-btn');
        colorBtn.setAttribute('type', 'button');
        colorBtn.style.backgroundColor = color;
        if (color.toLowerCase() === 'white') colorBtn.style.border = '1px solid #ddd';
        colorBtn.dataset.color = color;

        colorBtn.addEventListener('click', function () {
          document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('selected'));
          this.classList.add('selected');
        });

        colorContainer.appendChild(colorBtn);
      });

      // Auto-select the first available color
      const firstColorBtn = colorContainer.querySelector('.color-btn');
      if (firstColorBtn) firstColorBtn.classList.add('selected');
    }

    fetchProductData();


    let logo = document.querySelector(".navbar-brand");
    if (logo) {
      logo.style.position = "absolute";
      logo.style.top = "5.5px";
      logo.style.left = "50%";
      logo.style.transform = "translateX(-50%)";
    }
    const togglerIcon = document.querySelector(".navbar-toggler-icon");
    if (togglerIcon) {
      togglerIcon.addEventListener("click", function() {
        if (logo) {
          logo.style.position = "absolute";
          logo.style.top = "5.5px";
          logo.style.left = "50%";
          logo.style.transform = "translateX(-50%)";
        }
      });
    }

  });
</script>

<%- include("../partials/footer.ejs") %>